{
  "name": "csg-kernel",
  "version": "1.0.0",
  "description": "Proper BSP Constructive Solid Geometry kernel for three.js — BufferGeometry, world matrices, multi-material, wall/door prefab helpers.",
  "type": "module",
  "main": "./CSGKernel.js",
  "module": "./CSGKernel.js",
  "types": "./CSGKernel.d.ts",
  "bin": {
    "csg-kernel": "./bin/csg-kernel.js"
  },
  "exports": {
    ".": {
      "types": "./CSGKernel.d.ts",
      "import": "./CSGKernel.js",
      "default": "./CSGKernel.js"
    },
    "./mono": {
      "import": "./CSGKernel.mono.js",
      "default": "./CSGKernel.mono.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "CSGKernel.js",
    "CSGKernel.mono.js",
    "CSGKernel.d.ts",
    "src",
    "bin",
    "templates",
    "demo.html",
    "wall-prefab.html",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "demo": "node bin/csg-kernel.js demo",
    "prepublishOnly": "node --check CSGKernel.js && node --check src/csg.js && node --check bin/csg-kernel.js"
  },
  "peerDependencies": {
    "three": ">=0.150.0"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "three.js",
    "threejs",
    "csg",
    "boolean",
    "bsp",
    "constructive-solid-geometry",
    "mesh",
    "kernel",
    "procedural",
    "wall",
    "door",
    "window",
    "npx"
  ],
  "license": "MIT",
  "author": "BHTANK",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BHTANK/csg-kernel.git"
  },
  "bugs": {
    "url": "https://github.com/BHTANK/csg-kernel/issues"
  },
  "homepage": "https://github.com/BHTANK/csg-kernel#readme",
  "publishConfig": {
    "access": "public"
  }
}
